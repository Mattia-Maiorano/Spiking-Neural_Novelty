\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Forensic Failure-Mode Decomposition (50 PIL Episodes `[3600, 3649]`) \& $N=25$ Validation Checkpoint Selection (`[3200, 3224]` $\to $ `[3600, 3649]`).} Panel (a) decomposes closed-loop PIL episodes into overall reach ($\min _t e \le 3.0\,\text  {cm}$), total velocity violations ($\|\dot  {\mathbf  {q}}(t_{\text  {grasp}})\|_2 \ge \tau _{\text  {vel}}$, where $\tau _{\text  {vel}} = \max (1.5, 1.1\|\dot  {\mathbf  {q}}^*_{t_{\text  {grasp}}}\|_2)\,\text  {rad/s}$), and mutually exclusive failure modes: post-contact impulse divergence ($> 3.0\,\text  {cm}$ at $t_{\text  {grasp}} = t_c + 7$, split into \texttt  {Div + Vel} vs.\ \texttt  {Spatial}) and \texttt  {Other Fails} (reaching $\le 3\,\text  {cm}$ only post-$t_c$ then diverging, or settling within $3\,\text  {cm}$ but failing velocity/rotation gates: $1/50$ post-$t_c$ reach for Deep GRU; $7/50$ post-$t_c$ reach + $1/50$ vel-only + $6/50$ rot-only $= 14/50$ for \texttt  {ANN-Rate}; $4/50$ post-$t_c$ reach for SPWM; plus $1, 6, 2, 7, 0$, and $1$ episodes for RSSM Seeds 42/101/2024, Deep GRU, \texttt  {ANN-Rate}, and SPWM, respectively, that never reached $\le 3\,\text  {cm}$, so mutually exclusive outcomes sum to $100\%$). Panel (b) reports all 15 saved SPWM checkpoints evaluated on $N=25$ validation trajectories (`[3200, 3224]`) and the resulting test performance (`[3600, 3649]`) of $N=6$ Tier-2 vs.\ $N=25$ validation winners. Note that on Seed 42 at Ep 200, \texttt  {best\_model.pt} ($80.0\%$ val) stores EMA weights ($\tau =0.990$), whereas \texttt  {checkpoint\_phase\_3.pt} ($88.0\%$ val) stores raw un-averaged weights at the Latch Phase 3 boundary.}}{17}{}\protected@file@percent }
\newlabel{tab:forensic_diagnostics}{{6}{17}{}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Verified SPWM Submodule Parameter Census and Hyperparameters.} Total checkpoint parameter count ($392{,}141$) includes a $66{,}049$-parameter training-only terminal value head (\texttt  {LatentCritic}, $w_{\text  {critic}}=0.0$ at inference) and $8{,}192$ legacy \texttt  {dynamics.W\_vel.weight} parameters retained for \texttt  {strict=True} checkpoint compatibility, leaving $317{,}900$ active inference parameters.}}{17}{}\protected@file@percent }
